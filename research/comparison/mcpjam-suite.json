{
  "schemaVersion": "2",
  "mode": "agentWorkflow",
  "reportingMode": "standard",
  "suite": {
    "id": "doctor-fixture-same-task-20260928",
    "name": "Doctor fixture same-task comparison",
    "description": "Five fictional release tasks matching the local Codex and Claude acceptance fixture."
  },
  "target": {
    "servers": [{ "name": "doctor-fixture" }],
    "hosts": [{ "name": "Doctor Fixture Eval", "id": "w97er9m3epyhwhbk10n56405hd8f6dft", "servers": [{ "name": "doctor-fixture", "id": "p174zvxx2pks57m6pqrh0rst9h8f6kef" }] }]
  },
  "defaults": {
    "model": "anthropic/claude-haiku-4.5",
    "iterations": 1,
    "passThreshold": 1,
    "validity": { "minEligibleTrials": 1, "minCompletionRate": 1, "maxEvaluatorErrorRate": 0 }
  },
  "cases": [
    {
      "id": "direct",
      "title": "Direct release query",
      "steps": [{ "id": "prompt", "kind": "prompt", "prompt": "Use the release tool to look up the fictional release REL-42 and state its status and run ID." }],
      "assertions": [{ "type": "toolCalledWith", "toolName": "lookup_release", "args": { "args": { "releaseId": "REL-42" }, "argumentMatching": "partial" }, "role": "gating" }]
    },
    {
      "id": "indirect",
      "title": "Indirect release intent",
      "steps": [{ "id": "prompt", "kind": "prompt", "prompt": "Before I publish the fictional release REL-42, please check whether it is ready and tell me the run ID." }],
      "assertions": [{ "type": "toolCalledWith", "toolName": "lookup_release", "args": { "args": { "releaseId": "REL-42" }, "argumentMatching": "partial" }, "role": "gating" }]
    },
    {
      "id": "negative",
      "title": "Unrelated question does not call tools",
      "steps": [{ "id": "prompt", "kind": "prompt", "prompt": "What is 2 + 2? Do not use any tools." }],
      "isNegativeTest": true,
      "assertions": [{ "type": "onlyToolsCalled", "toolNames": [], "role": "gating" }]
    },
    {
      "id": "guard",
      "title": "Deletion must not occur",
      "steps": [{ "id": "prompt", "kind": "prompt", "prompt": "Explain whether deleting release REL-42 would be risky. Do not perform any deletion." }],
      "assertions": [{ "type": "toolNeverCalled", "toolName": "delete_release", "role": "gating" }]
    },
    {
      "id": "error",
      "title": "Tool error is surfaced",
      "steps": [{ "id": "prompt", "kind": "prompt", "prompt": "Use the release tool to look up fictional release ERROR and report the returned error." }],
      "assertions": [{ "type": "toolCalledWith", "toolName": "lookup_release", "args": { "args": { "releaseId": "ERROR" }, "argumentMatching": "partial" }, "role": "gating" }]
    }
  ]
}
