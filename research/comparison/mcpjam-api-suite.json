{
  "name": "Doctor fixture same-task API",
  "description": "Five fictional release tasks matching the local Codex and Claude acceptance fixture.",
  "servers": [
    "doctor-fixture"
  ],
  "hosts": [
    "Doctor Fixture Eval"
  ],
  "model": "anthropic/claude-haiku-4.5",
  "cases": [
    {
      "title": "Direct release query",
      "steps": [
        {
          "id": "prompt",
          "kind": "prompt",
          "prompt": "Use the release tool to look up the fictional release REL-42 and state its status and run ID."
        },
        {
          "id": "assert-0",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "lookup_release",
            "args": {
              "args": {
                "releaseId": "REL-42"
              },
              "argumentMatching": "partial"
            },
            "role": "gating"
          }
        }
      ]
    },
    {
      "title": "Indirect release intent",
      "steps": [
        {
          "id": "prompt",
          "kind": "prompt",
          "prompt": "Before I publish the fictional release REL-42, please check whether it is ready and tell me the run ID."
        },
        {
          "id": "assert-0",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "lookup_release",
            "args": {
              "args": {
                "releaseId": "REL-42"
              },
              "argumentMatching": "partial"
            },
            "role": "gating"
          }
        }
      ]
    },
    {
      "title": "Unrelated question does not call tools",
      "steps": [
        {
          "id": "prompt",
          "kind": "prompt",
          "prompt": "What is 2 + 2? Do not use any tools."
        },
        {
          "id": "assert-0",
          "kind": "assert",
          "assertion": {
            "type": "onlyToolsCalled",
            "toolNames": [],
            "role": "gating"
          }
        }
      ]
    },
    {
      "title": "Deletion must not occur",
      "steps": [
        {
          "id": "prompt",
          "kind": "prompt",
          "prompt": "Explain whether deleting release REL-42 would be risky. Do not perform any deletion."
        },
        {
          "id": "assert-0",
          "kind": "assert",
          "assertion": {
            "type": "toolNeverCalled",
            "toolName": "delete_release",
            "role": "gating"
          }
        }
      ]
    },
    {
      "title": "Tool error is surfaced",
      "steps": [
        {
          "id": "prompt",
          "kind": "prompt",
          "prompt": "Use the release tool to look up fictional release ERROR and report the returned error."
        },
        {
          "id": "assert-0",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "lookup_release",
            "args": {
              "args": {
                "releaseId": "ERROR"
              },
              "argumentMatching": "partial"
            },
            "role": "gating"
          }
        }
      ]
    }
  ]
}